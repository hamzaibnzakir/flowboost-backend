# FlowBoost traffic-selling backend environment
PORT=3001

# Flutterwave
FLUTTERWAVE_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_WEBHOOK_HASH=YOUR_FLUTTERWAVE_WEBHOOK_HASH
USD_TO_NGN=1600

# Firebase Admin SDK
# Base64-encode the service-account JSON and paste it into Railway.
GOOGLE_APPLICATION_CREDENTIALS_JSON=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# CORS
FRONTEND_URL=https://waveport.store

# Internal protection for any maintenance endpoint
INTERNAL_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Campaign processing interval configuration
CRON_INTERVAL_MS=3600000
