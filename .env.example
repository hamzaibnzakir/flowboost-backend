# ─────────────────────────────────────────────────────────────────────────────
# FlowBoost Backend — Environment Variables
# Copy this file to .env and fill in all values before starting the server
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# Port your VPS backend listens on
PORT=3001

# ── Flutterwave ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_WEBHOOK_HASH=YOUR_FLUTTERWAVE_WEBHOOK_HASH

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# 1. Firebase Console → Project Settings → Service Accounts
# 2. "Generate new private key" → download JSON
# 3. Put the JSON file in this folder as firebase-service-account.json
#    OR paste each field below individually:
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# Leave this blank if using the JSON file path below
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your frontend URL (GitHub Pages URL or custom domain)
# e.g. https://yourusername.github.io or https://yourdomain.com
FRONTEND_URL=https://yourusername.github.io

# ── Daily deduction config ───────────────────────────────────────────────────
# How often the cron job checks active burst campaigns (in ms)
# Default: every 60 seconds in dev, every hour in prod
CRON_INTERVAL_MS=3600000
